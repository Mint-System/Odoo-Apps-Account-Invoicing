<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record
        id="account_move_line_position.res_config_settings_view_form"
        model="ir.ui.view"
    >
    <field name="name">account_move_line_position.res_config_settings_view_form</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="account.res_config_settings_view_form" />
    <field name="arch" type="xml">
      <xpath
                expr="//div[contains(@class, 'group_show_sale_receipts')]"
                position="after"
            >
        <setting
                    id="get_positions_from_orders"
                    string="Position Numbers from Orders"
                    help="The position number of the invoice lines will be linked to the sale or purchase order lines."
                >
          <field name="get_positions_from_orders" />
          <label
                        for="get_positions_from_orders"
                        string="Position Numbers from Orders"
                    />
          <div class="text-muted">
            The position number of the invoice lines will be linked to the sale or purchase order lines.
          </div>
        </setting>
      </xpath>
    </field>
  </record>

</odoo>
